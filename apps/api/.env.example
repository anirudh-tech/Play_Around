NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Matches infrastructure/docker/docker-compose.yml
DATABASE_URL=postgresql://playaround:playaround@127.0.0.1:5433/playaround
# Render: paste Internal Database URL (same region as the API). If you use the
# External URL, append ?sslmode=require — public Render Postgres requires TLS.

# Comma-separated: web, admin, Expo web
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081

JOBS_ENABLED=true

JWT_SECRET=dev-only-change-me-jwt-secret-32ch
# 32-byte hex key used to encrypt staff TOTP secrets
TOTP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Local: Mailpit on 1025 (nodemailer). HTML is always src/lib/otp-email.ts.
# Render: set MAIL_RESEND_API_KEY (HTTPS). MAIL_FROM=PlayAround <beth.t@example.com>
# until you verify a domain. Without a domain Resend only delivers to the Resend account email.
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM=PlayAround <noreply@playaround.local>
MAIL_USER=
MAIL_PASSWORD=
MAIL_RESEND_API_KEY=

# Optional. Social sign-in returns 503 until these are set.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# Clerk Google (web). Same publishable key as Vercel NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Temporary: skip email OTP so password users can use the app after deploy.
AUTH_SKIP_EMAIL_VERIFY=false

STAFF_SEED_EMAIL=admin@playaround.local
STAFF_SEED_PASSWORD=PlayAroundAdmin1

# Optional. Expo push works for ExponentPushToken without this in development.
EXPO_ACCESS_TOKEN=

# Optional. Do not set until a Sentry project exists (L-08). Not wired in code yet.
# SENTRY_DSN=
